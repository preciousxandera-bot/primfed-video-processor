
const express = require("express");
const fs = require("fs");
const os = require("os");
const path = require("path");
const crypto = require("crypto");
const { execFile } = require("child_process");
const { promisify } = require("util");

const app = express();
const runFile = promisify(execFile);

app.use(express.json({ limit: "1mb" }));

const PORT = process.env.PORT || 3000;
const MAX_BYTES = 10 * 1024 * 1024;
const MAX_DURATION = 60;
const OUTPUT_DIR = path.join(os.tmpdir(), "primfed-videos");

fs.mkdirSync(OUTPUT_DIR, { recursive: true });

app.get("/", (req, res) => {
  res.json({ status: "Primfed video processor is running" });
});

app.get("/health", (req, res) => {
  res.json({ ok: true });
});

function checkApiKey(req, res, next) {
  const key = process.env.PRIMFED_API_KEY;

  if (!key || req.get("x-api-key") !== key) {
    return res.status(401).json({
      error: "Invalid or missing API key"
    });
  }

  next();
}

async function downloadVideo(url, destination) {
  const parsed = new URL(url);

  if (parsed.protocol !== "https:") {
    throw new Error("A secure HTTPS video URL is required");
  }

  const response = await fetch(url, {
    signal: AbortSignal.timeout(60000),
    redirect: "error"
  });

  if (!response.ok || !response.body) {
    throw new Error("Could not download the source video");
  }

  const declaredSize = Number(response.headers.get("content-length") || 0);

  if (declaredSize > MAX_BYTES) {
    throw new Error("Video exceeds the 10 MB limit");
  }

  const file = fs.createWriteStream(destination);
  let total = 0;

  try {
    for await (const chunk of response.body) {
      total += chunk.length;

      if (total > MAX_BYTES) {
        throw new Error("Video exceeds the 10 MB limit");
      }

      if (!file.write(chunk)) {
        await new Promise((resolve, reject) => {
          file.once("drain", resolve);
          file.once("error", reject);
        });
      }
    }

    await new Promise((resolve, reject) => {
      file.end(resolve);
      file.once("error", reject);
    });
  } catch (error) {
    file.destroy();
    throw error;
  }
}

app.post("/process", checkApiKey, async (req, res) => {
  const sourceUrl = req.body?.source_video_url;

  if (typeof sourceUrl !== "string") {
    return res.status(400).json({
      error: "source_video_url is required"
    });
  }

  let parsed;

  try {
    parsed = new URL(sourceUrl);
  } catch {
    return res.status(400).json({
      error: "Invalid video URL"
    });
  }

  if (parsed.protocol !== "https:") {
    return res.status(400).json({
      error: "HTTPS video URLs only"
    });
  }

  const id = crypto.randomUUID();
  const workDir = path.join(OUTPUT_DIR, id);
  const inputFile = path.join(workDir, "source.mp4");
  const playlist = path.join(workDir, "index.m3u8");

  try {
    fs.mkdirSync(workDir, { recursive: true });

    await downloadVideo(sourceUrl, inputFile);

    const { stdout } = await runFile("ffprobe", [
      "-v", "error",
      "-show_entries", "format=duration",
      "-of", "default=noprint_wrappers=1:nokey=1",
      inputFile
    ], { timeout: 15000 });

    const duration = Number(stdout.trim());

    if (!Number.isFinite(duration) || duration <= 0) {
      throw new Error("Could not read video duration");
    }

    if (duration > MAX_DURATION) {
      throw new Error("Video exceeds the 60-second limit");
    }

    await runFile("ffmpeg", [
      "-y",
      "-i", inputFile,
      "-map", "0:v:0",
      "-map", "0:a:0?",
      "-c:v", "libx264",
      "-preset", "veryfast",
      "-pix_fmt", "yuv420p",
      "-c:a", "aac",
      "-b:a", "96k",
      "-f", "hls",
      "-hls_time", "1",
      "-hls_playlist_type", "vod",
      "-hls_segment_filename",
      path.join(workDir, "segment_%03d.ts"),
      playlist
    ], { timeout: 120000, maxBuffer: 1024 * 1024 });

    fs.unlinkSync(inputFile);

    res.json({
      status: "processed",
      job_id: id,
      duration_seconds: duration,
      manifest_url: `/videos/${id}/index.m3u8`
    });
  } catch (error) {
    fs.rmSync(workDir, { recursive: true, force: true });

    res.status(400).json({
      error: error.message || "Video processing failed"
    });
  }
});

app.get("/videos/:id/:file", (req, res) => {
  const { id, file } = req.params;

  if (!/^[a-f0-9-]{36}$/i.test(id) ||
      !/^(index\.m3u8|segment_\d+\.ts)$/.test(file)) {
    return res.sendStatus(404);
  }

  const filePath = path.join(OUTPUT_DIR, id, file);

  if (!fs.existsSync(filePath)) {
    return res.sendStatus(404);
  }

  res.type(file.endsWith(".m3u8") ? "application/vnd.apple.mpegurl" : "video/mp2t");
  res.sendFile(filePath);
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`Primfed server running on port ${PORT}`);
});
